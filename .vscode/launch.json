{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug client (Release)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\bin\\amd64\\redeclipse.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "Build (Release)"
        },
        {
            "name": "Debug client (Debug build, breakpoints)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\bin\\amd64\\redeclipse.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "Build (Debug)"
        },
        {
            "name": "Attach to running redeclipse.exe",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
